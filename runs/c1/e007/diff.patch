+
+
+def box_feats(r):
+    ls = max(r["x2"] - r["x1"], r["y2"] - r["y1"], 1.0)
+    ar = (r["x2"] - r["x1"]) / max(r["y2"] - r["y1"], 1e-6)
+    conf = max(float(r.get("conf", 0.5)), 1e-4)
+    return np.array([
+        float(np.interp(ls, FEAT_GRID[0], FEAT_AXIS)),
+        float(np.interp(ar, FEAT_GRID[1], FEAT_AXIS)),
+        float(np.interp(conf, FEAT_GRID[2], FEAT_AXIS)),
+    ], dtype=np.float32)
 
 
