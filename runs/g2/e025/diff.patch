+_SHARED = {}  # filled before fork so pool workers inherit it via copy-on-write
+
+
+def _precompute_one(i):
+    r = _SHARED["rows"][i]
+    img = _SHARED["images"][r["image"]]
+    out = []
+    for _ in range(_SHARED["K"]):
+        views = []
+        for ctx in (TIGHT_CONTEXT, CONTEXT, WIDE2_CONTEXT):
+            x = make_crop(img, r, ctx, True)
+            x = (x - MEAN) / STD
+            views.append(np.ascontiguousarray(x.transpose(2, 0, 1)))
+        out.append(tuple(views))
+    return i, (r["cls"], out)
+
+
+def precompute_variants(rows, images, K):
+    from multiprocessing import Pool
+    _SHARED["rows"], _SHARED["images"], _SHARED["K"] = rows, images, K
+    res = [None] * len(rows)
+    with Pool(os.cpu_count() or 2) as pool:
+        for i, item in pool.imap_unordered(_precompute_one, range(len(rows))):
+            res[i] = item
+    _SHARED.clear()
+    return res
+
+
