+    # Precompute the three eval crops once (no jitter, exactly as make_crop does at eval) so the
+    # prediction phase is just normalise + forward instead of ~60 s of on-the-fly crop/resize.
+    t_pc = time.time()
+    from concurrent.futures import ProcessPoolExecutor
