+    class EvPreDataset(torch.utils.data.Dataset):
+        def __init__(self, rows, crops):
+            self.rows, self.crops = rows, crops
+
+        def __len__(self):
+            return len(self.rows)
+
+        def __getitem__(self, i):
+            views = []
+            for x in self.crops[i]:
+                x = (x - MEAN) / STD
+                views.append(torch.from_numpy(np.ascontiguousarray(x.transpose(2, 0, 1))))
+            return views[0], views[1], views[2], -1
+
