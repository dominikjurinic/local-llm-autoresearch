+
+    def _mk_eval_crop(a):
+        img, r, ctxs = a
+        out = []
+        for ctx in ctxs:
+            out.append(make_crop(img, r, ctx, False))
+        return out
+
+    with ProcessPoolExecutor(max_workers=min(8, os.cpu_count() or 2)) as ex:
+        ev_crops = list(ex.map(_mk_eval_crop, [(images[d["image"]], d, _EV_CTX) for d in ev], chunksize=64))
