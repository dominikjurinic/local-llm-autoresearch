--- e001/train.py
+++ e006/train.py
@@ -128,4 +128,26 @@
     dets = read_csv(os.path.join(args.data, "dets.csv"))
     ev = [d for d in dets if d["split"] == "eval"]
+    # Align training boxes to detector output distribution
+    train_dets = [d for d in dets if d["split"] == "train"]
+    dets_by_img = {}
+    for d in train_dets:
+        dets_by_img.setdefault(d["image"], []).append(d)
+    n_matched = 0
+    for i, c in enumerate(crops):
+        best_det, best_iou = None, 0.0
+        for d in dets_by_img.get(c["image"], []):
+            ix1, iy1 = max(c["x1"], d["x1"]), max(c["y1"], d["y1"])
+            ix2, iy2 = min(c["x2"], d["x2"]), min(c["y2"], d["y2"])
+            inter = max(0.0, ix2 - ix1) * max(0.0, iy2 - iy1)
+            union = (c["x2"] - c["x1"]) * (c["y2"] - c["y1"]) + (d["x2"] - d["x1"]) * (d["y2"] - d["y1"]) - inter
+            iou = inter / max(union, 1e-6)
+            if iou > best_iou:
+                best_iou, best_det = iou, d
+        if best_det is not None and best_iou > 0.3:
+            nc = dict(c)
+            nc["x1"], nc["y1"], nc["x2"], nc["y2"] = best_det["x1"], best_det["y1"], best_det["x2"], best_det["y2"]
+            crops[i] = nc
+            n_matched += 1
+    print(f"aligned {n_matched}/{len(crops)} training boxes to detector boxes", flush=True)
     needed = {r["image"] for r in crops} | {d["image"] for d in ev}
     images = {p: np.asarray(Image.open(os.path.join(args.data, "images", p)).convert("RGB")) for p in needed}
