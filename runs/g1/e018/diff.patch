--- e005/train.py
+++ e018/train.py
@@ -167,4 +167,19 @@
     model = TwoViewModel(backbone, head)
     crit = nn.CrossEntropyLoss()
+    # Confused-class margin loss: push logit_true above logit_confused by at least MARGIN.
+    # Pairs from the confusion matrix: pore(0)-stain(3), stain(3)-deposit(1), deposit(1)-stain(3)
+    CONFUSED_PAIRS = [(0, 3), (0, 1), (3, 0), (3, 1), (1, 3)]
+    MARGIN = 1.0
+    MARGIN_WEIGHT = 0.5
+
+    def margin_loss(logits, targets):
+        # logits: (B, 4), targets: (B,)
+        total = torch.tensor(0.0, device=logits.device)
+        for c_true, c_conf in CONFUSED_PAIRS:
+            mask = (targets == c_true)
+            if mask.any():
+                gap = logits[mask, c_true] - logits[mask, c_conf]
+                total = total + (MARGIN - gap).clamp(min=0).sum()
+        return total / max(len(targets), 1)
     opt = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)
     amp = dict(device_type=device.type, dtype=torch.bfloat16, enabled=device.type == "cuda")
@@ -187,5 +202,6 @@
             y = y.to(device, non_blocking=True)
             with torch.autocast(**amp):
-                loss = crit(model(xt, xw), y)
+                logits = model(xt, xw)
+                loss = crit(logits, y) + MARGIN_WEIGHT * margin_loss(logits.float(), y)
             opt.zero_grad(set_to_none=True)
             loss.backward()
