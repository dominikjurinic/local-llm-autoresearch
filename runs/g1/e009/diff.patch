     crops = [r for r in read_csv(os.path.join(args.data, "crops.csv")) if r["res"] in TRAIN_ON]
     dets = read_csv(os.path.join(args.data, "dets.csv"))
+    tr_det = [d for d in dets if d["split"] == "train"]
     ev = [d for d in dets if d["split"] == "eval"]
+
+    # extra training rows: train-split detector boxes that overlap a true box (IoU > 0.5), labelled with it
+    by_img = {}
+    for r in crops:
+        by_img.setdefault(r["image"], []).append(r)
+    det_rows = []
+    for d in tr_det:
+        cands = by_img.get(d["image"])
+        if not cands:
+            continue
+        cx1 = np.maximum([c["x1"] for c in cands], d["x1"]); cy1 = np.maximum([c["y1"] for c in cands], d["y1"])
+        cx2 = np.minimum([c["x2"] for c in cands], d["x2"]); cy2 = np.minimum([c["y2"] for c in cands], d["y2"])
+        inter = np.maximum(cx2 - cx1, 0) * np.maximum(cy2 - cy1, 0)
+        ac = np.array([(c["x2"] - c["x1"]) * (c["y2"] - c["y1"]) for c in cands])
+        ad = (d["x2"] - d["x1"]) * (d["y2"] - d["y1"])
+        iou = inter / np.maximum(ac + ad - inter, 1e-9)
+        j = int(np.argmax(iou))
+        if iou[j] > 0.5:
+            row = dict(d); row["cls"] = cands[j]["cls"]
+            det_rows.append(row)
+    crops = crops + det_rows
     needed = {r["image"] for r in crops} | {d["image"] for d in ev}
     images = {p: np.asarray(Image.open(os.path.join(args.data, "images", p)).convert("RGB")) for p in needed}
