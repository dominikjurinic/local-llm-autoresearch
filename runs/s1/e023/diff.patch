+class TwoCropClassifier(nn.Module):
+    """Concatenates mean-pooled features of tight and wide crops, learns per-class weighting."""
+    def __init__(self, name, pretrained, hidden=256):
+        super().__init__()
+        self.backbone = timm.create_model(name, pretrained=pretrained, num_classes=0)
+        self.dim = self.backbone.num_features
+        self.head = nn.Sequential(
+            nn.Linear(self.dim * 2, hidden),
+            nn.GELU(),
+            nn.Dropout(0.25),
+            nn.Linear(hidden, 4))
+
+    def forward(self, xt, xw):
+        f1 = self.backbone(xt).flatten(1)
+        f2 = self.backbone(xw).flatten(1)
+        return self.head(torch.cat((f1, f2), -1))
 
 
