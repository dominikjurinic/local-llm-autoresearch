+    # learned combination of tight + wide crop features per box, instead of logit averaging
+    class TwoCropMLP(nn.Module):
+        def __init__(self, feat_dim=320, hidden=128, num_classes=4):
+            super().__init__()
+            self.backbone = timm.create_model(MODEL, pretrained=PRETRAINED, num_classes=0)
+            self.mlp = nn.Sequential(
+                nn.Linear(feat_dim * 2, hidden),
+                nn.ReLU(),
+                nn.Dropout(0.3),
+                nn.Linear(hidden, num_classes),
+            )
+
+        def forward(self, xt, xw):
+            xt = self.backbone.forward_features(xt)
+            xw = self.backbone.forward_features(xw)
+            ft = self.backbone.global_pool(xt).flatten(1)
+            fw = self.backbone.global_pool(xw).flatten(1)
+            return self.mlp(torch.cat([ft, fw], 1))
+
