+class TwoCropMLP(nn.Module):
+    def __init__(self, backbone, n_feats):
+        super().__init__()
+        self.backbone = backbone
+        self.head = nn.Sequential(
+            nn.Linear(2 * n_feats, 128),
+            nn.GELU(),
+            nn.Linear(128, 4),
+        )
+
+    def forward(self, xtight, xwide):
+        f1 = self.backbone(xtight)[-1].flatten(2).mean(-1)
+        f2 = self.backbone(xwide)[-1].flatten(2).mean(-1)
+        return self.head(torch.cat([f1, f2], 1))
+
+
